# Copy to .env and fill in. Never commit .env.
# 1 = deterministic offline mode (fake app LLM + fake judge). Default when no key is set.
MOCK_LLM=1

# Provider for app + judge: anthropic | openai (any OpenAI-compatible endpoint)
LLM_PROVIDER=anthropic
APP_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Retrieval: onnx (local MiniLM ONNX model, ~80 MB one-off download) | hashing (no download)
EMBEDDING_BACKEND=onnx

# Number of judge repetitions for LLM-judged metrics (median is used)
JUDGE_REPEATS=3

# LangSmith tracing (optional; silent no-op when unset)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-quality-gate

# AWS (only for the Athena / S3 path; everything has a local DuckDB / moto equivalent)
# AWS_REGION=ap-south-1
# RQG_S3_BUCKET=
# RQG_ATHENA_WORKGROUP=rqg
# RQG_ATHENA_DATABASE=rqg_logs
